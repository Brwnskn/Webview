    <string name="step_3_scan_entities">3. Scan Nearby Entities</string>
    <string name="wizard_step_3_instruction">Make sure 2+ monsters or entities are visible on your screen, then tap \'3. Scan Nearby Entities\' (anchored to Step 2B\'s player parent container).</string>

    <string name="wizard_step_4_title">Step 4 — Export Handoff Report</string>
